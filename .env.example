# ApiHub 环境变量配置
# 复制此文件为 .env 并填入真实值，或启动前在 shell 中 export。

# MySQL 数据库密码（api-auth / api-admin / api-gateway 共用）
# 默认连接 47.104.243.13:3306/apihub 用户 ApiHub
DB_PASSWORD=

# JWT 签名密钥（api-auth 签发 / api-gateway 验证，必须一致）
# 建议 ≥32 字符随机字符串
JWT_SECRET=

# 高德地图天气 API Key（api-invoke 使用）
# 在 https://console.amap.com 申请
AMAP_KEY=

# Redis 连接配置（可选，网关非内存 Nonce 使用）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=