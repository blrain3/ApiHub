# ApiHub 环境变量配置示例
# 复制为 .env 并填入真实值，或启动前 export / 写入 application-local.yml（已 gitignore）
# IDE 也可激活 profile：--spring.profiles.active=local

# ----- 数据库 -----
# DB_URL=jdbc:mysql://127.0.0.1:3306/apihub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ----- JWT（api-auth 签发 / api-gateway 验证，必须一致，建议 ≥32 字符）-----
JWT_SECRET=
JWT_EXPIRE_SECONDS=7200

# ----- 高德天气（api-invoke）-----
AMAP_KEY=
# AMAP_BASE_URL=https://restapi.amap.com

# ----- Redis（可选）-----
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ----- 服务路由（可选）-----
# ROUTE_AUTH=http://127.0.0.1:8081
# ROUTE_ADMIN=http://127.0.0.1:8082
# ROUTE_INVOKE=http://127.0.0.1:8083

# ----- Docker Compose MySQL -----
# MYSQL_ROOT_PASSWORD=root
