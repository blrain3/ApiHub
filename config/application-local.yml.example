# 本地私密配置模板：复制为 application-local.yml 后填写真实值
# 启动时激活：--spring.profiles.active=local
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/apihub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your-db-password

apihub:
  jwt:
    secret: replace-with-a-long-random-secret-at-least-32-chars
